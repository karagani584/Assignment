import React from 'react';
import ReactDOM from 'react-dom/client';

// Create the nested structure
const nestedElement = React.createElement(
  'div',
  { className: 'title' }, // Attributes for the div
  React.createElement(
    'h1',
    { id: 'main-heading', style: { color: 'blue' } }, // Attributes for h1
    'Main Title'
  ),
  React.createElement(
    'h2',
    { className: 'sub-heading' }, // Attributes for h2
    'Secondary Title'
  ),
  React.createElement(
    'h3',
    { 'data-info': 'tertiary' }, // Attributes for h3 (custom data attribute)
    'Tertiary Title'
  )
);

// Render the element to the root
const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(nestedElement);
